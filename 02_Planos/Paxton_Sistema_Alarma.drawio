onalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#1f4e79;strokeWidth=2;exitX=0.5;exitY=0.5;entryX=0.5;entryY=0.5;" edge="1" parent="L4" source="D-107" target="M-101"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="738" /></Array></mxGeometry></mxCell><mxCell id="w0_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#1f4e79;strokeWidth=2;exitX=0.5;exitY=0.5;entryX=0.5;entryY=0.5;" edge="1" parent="L4" source="D-104" target="D-105"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="1210" /></Array></mxGeometry></mxCell><mxCell id="tit" value="PISO 1 - Sistema de deteccion y alarma" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="L5"><mxGeometry x="1720" y="30" width="640" height="34" as="geometry" /></mxCell><mxCell id="sub" value="Paxton Carnegie Library — 254 S. Market St, Paxton, Ford County, Illinois&#10;Fondo: HABS IL-329, láminas 3 y 4, escala original 1/4&quot;=1'-0&quot; (comprobar con la escala gráfica impresa en el fondo)&#10;Sistema Fire•Lite MS-9600LS direccionable — 1 lazo SLC Clase B (Style 4), 4 NAC Clase B (Style Y)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="L5"><mxGeometry x="1720" y="70" width="640" height="80" as="geometry" /></mxCell><mxCell id="legbox" value="LEYENDA DE SIMBOLOS" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="L5"><mxGeometry x="1720" y="170" width="620" height="420" as="geometry" /></mxCell><mxCell id="lg0" value="S" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=9;fontStyle=1" vertex="1" parent="L5"><mxGeometry x="1740" y="210" width="30" height="30" as="geometry" /></mxCell><mxCell id="lgt0" value="Detector de humo direccionable  SD355" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="L5"><mxGeometry x="1790" y="214" width="530" height="20" as="geometry" /></mxCell><mxCell id="lg1" value="T" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b45f06;strokeWidth=2;fontSize=9;fontStyle=1" vertex="1" parent="L5"><mxGeometry x="1740" y="252" width="30" height="30" as="geometry" /></mxCell><mxCell id="lgt1" value="Detector termico direccionable  H355R" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="L5"><mxGeometry x="1790" y="256" width="530" height="20" as="geometry" /></mxCell><mxCell id="lg2" value="M" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=8;fontStyle=1" vertex="1" parent="L5"><mxGeometry x="1740" y="294" width="26" height="26" as="geometry" /></mxCell><mxCell id="lgt2" value="Estacion manual  BG-12LX" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="L5"><mxGeometry x="1790" y="298" width="530" height="20" as="geometry" /></mxCell><mxCell id="lg3" value="HS" style="whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#cc0000;strokeWidth=2;fontSize=8;fontStyle=1" vertex="1" parent="L5"><mxGeometry x="1740" y="336" width="28" height="28" as="geometry" /></mxCell><mxCell id="lgt3" value="Horn/Strobe  System Sensor P2R" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="L5"><mxGeometry x="1790" y="340" width="530" height="20" as="geometry" /></mxCell><mxCell id="lg4" value="ST" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=8;fontStyle=1" vertex="1" parent="L5"><mxGeometry x="1740" y="378" width="28" height="28" as="geometry" /></mxCell><mxCell id="lgt4" value="Strobe solo  System Sensor SR" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="L5"><mxGeometry x="1790" y="382" width="530" height="20" as="geometry" /></mxCell><mxCell id="lg5" value="ANN" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5ea7;strokeWidth=2;fontSize=8;fontStyle=1" vertex="1" parent="L5"><mxGeometry x="1740" y="420" width="30" height="30" as="geometry" /></mxCell><mxCell id="lgt5" value="Anunciador remoto  ANN-80" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="L5"><mxGeometry x="1790" y="424" width="530" height="20" as="geometry" /></mxCell><mxCell id="lg6" value="FACP" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d6a2d;strokeWidth=3;fontSize=10;fontStyle=1" vertex="1" parent="L5"><mxGeometry x="1740" y="462" width="30" height="30" as="geometry" /></mxCell><mxCell id="lgt6" value="Panel de control  Fire-Lite MS-9600LS" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="L5"><mxGeometry x="1790" y="466" width="530" height="20" as="geometry" /></mxCell><mxCell id="lg7" value="SLC&#10;NAC&#10;ANN" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e79;strokeWidth=2;fontSize=8;fontStyle=1;dashed=1;fontSize=6;" vertex="1" parent="L5"><mxGeometry x="1740" y="502" width="34" height="34" as="geometry" /></mxCell><mxCell id="lgt7" value="Montante entre niveles: lazo SLC + NAC + ANN-BUS" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="L5"><mxGeometry x="1790" y="508" width="530" height="20" as="geometry" /></mxCell><mxCell id="wbox" value="CIRCUITOS Y CRITERIO DE RECORRIDO" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="L5"><mxGeometry x="1720" y="620" width="620" height="330" as="geometry" /></mxCell><mxCell id="wnote" value="Línea continua azul   = lazo SLC (detección direccionable, Clase B / Style 4)&#10;Línea punteada roja  = circuito NAC (notificación, Clase B / Style Y)&#10;Línea punteada morada = ANN-BUS EIA-485 al anunciador ANN-80&#10;Cada tramo lleva rótulo SLC / NAC-n sobre el recorrido.&#10;&#10;El lazo SLC y los cuatro NAC ARRANCAN EN EL FACP (Electrical Room, sótano)&#10;y suben al piso 1 por el montante de la escalera del South Foyer, única&#10;conexión vertical interior del edificio.&#10;&#10;Cada NAC Clase B termina en resistencia EOL de 4,7 kΩ ½ W (P/N 71252).&#10;El lazo SLC Style 4 NO lleva EOL: se supervisa por comunicación (doc. 51309).&#10;&#10;El cableado corre pegado a muros y por la circulación, y atraviesa tabiques&#10;sólo en los vanos de puerta. Los aparatos de notificación van montados SOBRE&#10;muro, con la lente entre 80 y 96 in del piso terminado (NFPA 72-2013 18.5.5.1),&#10;y destellan SINCRONIZADOS: los 4 NAC se programan con sincronización tipo&#10;System Sensor en el panel (manual 52646:B, §3.6.5.5.8); no hace falta MDL3." style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="L5"><mxGeometry x="1732" y="655" width="600" height="290" as="geometry" /></mxCell><mxCell id="w0_8b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#1f4e79;strokeWidth=2;exitX=0.5;exitY=0.5;entryX=0.5;entryY=0.5;" edge="1" parent="L4" source="M-101" target="D-104"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1287" y="750" /><mxPoint x="850" y="750" /></Array></mxGeometry></mxCell><mxCell id="RIS-1_L" value="MONTANTE" style="text;html=1;fontSize=9;fontStyle=1;align=left;labelBackgroundColor=#FFFFFF;" vertex="1" parent="L2"><mxGeometry x="664" y="1240" width="66" height="16" as="geometry" /></mxCell><mxCell id="n1_0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#cc0000;strokeWidth=2;exitX=0.5;exitY=0.5;entryX=0.5;entryY=0.5;dashed=1;" edge="1" parent="L4" source="RIS-1" target="N-104"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="1247" /><mxPoint x="690" y="850" /></Array></mxGeometry></mxCell><mxCell id="n1_1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#cc0000;strokeWidth=2;exitX=0.5;exitY=0.5;entryX=0.5;entryY=0.5;dashed=1;" edge="1" parent="L4" source="N-104" target="N-101"><mxGeometry relative="1" as="geometry"><Arra