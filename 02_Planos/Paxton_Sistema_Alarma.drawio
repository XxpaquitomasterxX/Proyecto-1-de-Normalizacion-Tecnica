.5;dashed=1;" edge="1" parent="L4" source="N-004" target="EOL4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ab0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#7b5ea7;strokeWidth=2;exitX=0.5;exitY=0.5;entryX=0.5;entryY=0.5;dashed=1;dashPattern=10 6;" edge="1" parent="L4" source="FACP" target="RIS-0" value="ANN-BUS"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="1362" /></Array></mxGeometry></mxCell><mxCell id="tagN3" value="NAC-3" style="text;html=1;fontSize=10;fontStyle=1;align=left;labelBackgroundColor=#FFFFFF;fontColor=#cc0000;" vertex="1" parent="L4"><mxGeometry x="1035" y="655" width="46" height="14" as="geometry" /></mxCell><mxCell id="tagN4" value="NAC-4" style="text;html=1;fontSize=10;fontStyle=1;align=left;labelBackgroundColor=#FFFFFF;fontColor=#cc0000;" vertex="1" parent="L4"><mxGeometry x="178" y="1205" width="46" height="14" as="geometry" /></mxCell><mxCell id="tagS0" value="SLC" style="text;html=1;fontSize=10;fontStyle=1;align=left;labelBackgroundColor=#FFFFFF;fontColor=#1f4e79;" vertex="1" parent="L4"><mxGeometry x="385" y="1148" width="40" height="14" as="geometry" /></mxCell><mxCell id="lg8" value="EOL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cc0000;strokeWidth=2;fontSize=8;fontStyle=1;fontColor=#cc0000;" vertex="1" parent="L5"><mxGeometry x="1740" y="548" width="40" height="20" as="geometry" /></mxCell><mxCell id="lgt8" value="Resistencia de fin de línea NAC  4,7 kΩ ½ W  (P/N 71252)" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="L5"><mxGeometry x="1790" y="548" width="530" height="20" as="geometry" /></mxCell><mxCell id="north" value="N" style="triangle;direction=north;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="L5"><mxGeometry x="1745" y="990" width="46" height="62" as="geometry" /></mxCell><mxCell id="northt" value="NORTE según la lámina HABS original.&#10;El plano se dibuja con el norte hacia arriba." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="L5"><mxGeometry x="1810" y="990" width="520" height="62" as="geometry" /></mxCell><mxCell id="tbox" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="L5"><mxGeometry x="1720" y="1090" width="620" height="230" as="geometry" /></mxCell><mxCell id="tboxt" value="PROYECTO:  Sistema de detección y alarma contra incendios&#10;EDIFICIO:  Paxton Carnegie Library — 254 S. Market St, Paxton, Ford Co., Illinois&#10;CURSO:     EL-4601 Normalización Técnica para Electrónica — Proyecto No. 1&#10;NORMAS:    NFPA 72-2013 · NFPA 101-2015 · NEC (NFPA 70) Art. 760 · UL 864&#10;&#10;LÁMINA:    2 de 3   —   PLANTA SÓTANO&#10;ESCALA:    fondo a 1/4&quot;=1'-0&quot; (lámina HABS 3) — verificar al imprimir&#10;REVISIÓN:  B   —   FECHA: ________________&#10;AUTORES:   ______________________________________" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="L5"><mxGeometry x="1734" y="1104" width="600" height="205" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Riser - Interconexion" id="r1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bandP1" value="PISO 1" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="110.0" width="1170" height="420" as="geometry" /></mxCell><mxCell id="bandSB" value="SOTANO" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="570.0" width="1170" height="420" as="geometry" /></mxCell><mxCell id="AC" value="ACOMETIDA PRINCIPAL&#10;120 VAC, 50/60 Hz, 3,0 A&#10;Circuito derivado DEDICADO y EXCLUSIVO&#10;Rotulado &quot;FIRE ALARM&quot;&#10;14 AWG, aislamiento 600 V&#10;Sin dispositivos de desconexion&#10;Proteccion segun NEC Art. 760" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=11;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="612" width="250" height="120" as="geometry" /></mxCell><mxCell id="FACP" value="FACP  Fire-Lite MS-9600LS&#10;Electrical Room (sotano)&#10;&#10;- Direccionable, protocolo LiteSpeed&#10;- Fuente conmutada 7 A&#10;- 1 lazo SLC (expandible a 2)&#10;- 4 NAC Style Y (Clase B)&#10;- 3 rele Form-C&#10;- FM Approved / UL 864" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=11;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#2d6a2d;strokeWidth=3;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="735.0" width="250" height="150" as="geometry" /></mxCell><mxCell id="BAT" value="RESPALDO SECUNDARIO&#10;2 x bateria sellada 12 V / 12 AH&#10;en serie = 24 VDC, 12 AH&#10;&#10;NFPA 72 (sistema Local):&#10;24 h standby + 5 min alarma&#10;Calculado: 4,26 AH  |  Instalado: 12 AH&#10;(gobierna el minimo del panel)" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=11;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#b45f06;" vertex="1" parent="1"><mxGeometry x="70" y="910.0" width="250" height="125" as="geometry" /></mxCell><mxCell id="ANN" value="ANN-80  Anunciador remoto LCD&#10;East Foyer (entrada principal)&#10;&#10;Permite al cuerpo de bomberos leer&#10;el estado del sistema al ingresar,&#10;sin entrar al sotano." style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=11;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#7b5ea7;" vertex="1" parent="1"><mxGeometry x="360" y="150.0" width="240" height="110" as="geometry" /></mxCell><mxCell id="SLCP1" value="LAZO SLC  -  PISO 1   (10 puntos)&#10;&#10;D-101  Humo   Stacks (1/2)&#10;D-102  Humo   Stacks (2/2)&#10;D-103  Humo   North Reading Room&#10;D-104  Humo   Circulacion central&#10;D-105  Humo   Rotonda (South Reading)&#10;D-106  Humo   Librarians Office&#10;D-107  Humo   East Foyer&#10;D-108  Humo   South Foyer / cabeza escalera&#10;M-101  Manual  Salida este (principal)&#10;M-102  Manual  Salida sur" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=11;strokeWidth=2;fillColor=#dae8fc;strokeColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="650" y="150.0" width="290" height="215" as="geometry" /></mxCell><mxCell id="SLCSB" value="LAZO SLC  -  SOTANO   (11 puntos)&#10;&#10;D-001  Humo   Childrens Reading Room NO&#10;D-002  Humo   Storage Room NE&#10;D-003  Humo   Childrens Room (rotonda)&#10;D-004  Humo   Hallway&#10;D-005  Humo   Electrical Room&#10;D-006  Humo   Janitors Closet&#10;D-007  Humo   South Foyer (pie escalera)&#10;H-001  TERMICO  Mechanical Room oeste&#10;H-002  TERMICO  Mechanical Room este&#10;M-001  Manual  Salida exterior norte&#10;M-002  Manual  Salida exterior este" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=11;strokeWidth=2;fillColor=#dae8fc;strokeColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="650" y="610.0" width="290" height="230" as="geometry" /></mxCell><mxCell id="NAC1" value="NAC-1   Piso 1 - ala norte&#10;N-101  H/S  75 cd   Stacks&#10;N-104  H/S  15 cd   Circulacion&#10;N-102  H/S  15 cd   North Reading&#10;I = 0,334 A   (11,1% de 3,0 A)&#10;L = 167 ft  -&gt;  Vfinal 19,85 V" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=11;strokeWidth=2;fillColor=#ffcccc;strokeColor=#cc0000;" vertex="1" parent="1"><mxGeometry x="990" y="150.0" width="215" height="110" as="geometry" /></mxCell><mxCell id="NAC2" value="NAC-2   Piso 1 - ala sur   &lt;- caso mas desfavorable&#10;N-103  H/S  30 cd   Rotonda&#10;N-105  ST   15 cd   Librarians Office&#10;N-106  ST   15 cd   Bath&#10;N-107  H/S  15 cd   East Foyer&#10;N-108  H/S  15 cd   South Foyer&#10;I = 0,397 A   (13,2% de 3,0 A)&#10;L = 174 ft  -&gt;  Vfinal 19,72 V" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=11;strokeWidth=2;fillColor=#ffcccc;strokeColor=#cc0000;" vertex="1" parent="1"><mxGeometry x="990" y="290.0" width="215" height="140" as="geometry" /></mxCell><mxCell id="NAC3" value="NAC-3   Sotano - ala norte&#10;N-001  H/S  30 cd   Childrens NO&#10;N-002  H/S  15 cd   Storage NE&#10;N-003  H/S  30 cd   Childrens rotonda&#10;I = 0,293 A   (9,8% de 3,0 A)&#10;L = 100 ft  -&gt;  Vfinal 20,11 V" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=11;strokeWidth=2;fillColor=#ffcccc;strokeColor=#cc0000;" vertex="1" parent="1"><mxGeometry x="990" y="610.0" width="215" height="110" as="geometry" /></mxCell><mxCell id="NAC4" value="NAC-4   Sotano - ala sur&#10;N-004  H/S  15 cd   Hallway&#10;N-005  ST   15 cd   Womens Restroom&#10;N-006  ST   15 cd   Mens Restroom&#10;N-007  H/S  15 cd   South Foyer&#10;I = 0,290 A   (9,7% de 3,0 A)&#10;L = 74 ft  -&gt;  Vfinal 20,19 V" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=11;strokeWidth=2;fillColor=#ffcccc;strokeColor=#cc0000;" vertex="1" parent="1"><mxGeometry x="990" y="750.0" width="215" height="120" as="geometry" /></mxCell><mxCell id="e1" value="120 VAC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#b45f06;endArrow=blockThin;" edge="1" parent="1" source="AC" target="FACP"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="24 VDC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#b45f06;endArrow=blockThin;" edge="1" parent="1" source="FACP" target="BAT"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="ANN-BUS (EIA-485)&#10;4 cond. 18 AWG, Clase B" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#7b5ea7;dashed=1;endArrow=none;exitX=1;exitY=0.15;entryX=0.5;entryY=1;" edge="1" parent="1" source="FACP" target="ANN"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="817" /></Array></mxGeometry></mxCell><mxCell id="e4" value="SLC  Clase B (Style 4)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#1f4e79;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="FACP" target="SLCSB"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="870" /></Array></mxGeometry></mxCell><mxCell id="e5" value="RISER: sube por la escalera&#10;del South Foyer (unica&#10;conexion vertical interior)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#1f4e79;endArrow=none;" edge="1" parent="1" source="SLCSB" target="SLCP1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#cc0000;dashed=1;endArrow=none;exitX=1;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="1" source="FACP" target="NAC1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="897" /></Array></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#cc0000;dashed=1;endArrow=none;exitX=1;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="1" source="FACP" target="NAC2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="897" /></Array></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#cc0000;dashed=1;endArrow=none;exitX=1;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="1" source="FACP" target="NAC3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="897" /></Array></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#cc0000;dashed=1;endArrow=none;exitX=1;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="1" source="FACP" target="NAC4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="897" /></Array></mxGeometry></mxCell><mxCell id="VER" value="VERIFICACIONES DE CAPACIDAD" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="120.0" width="410" height="280" as="geometry" /></mxCell><mxCell id="VERT" value="Lazo SLC        17 detectores / 159      10,7 %   OK&#10;                 4 modulos    / 159       2,5 %   OK&#10;                 1 lazo (no requiere SLC-2LS)&#10;                ~1200 ft / 4 875 ft (16 AWG) 24,6 %  OK&#10;                R c.c. 11,7 ohm / 40 ohm max (Style 4) OK&#10;&#10;NAC mayor       0,397 A / 3,0 A          13,2 %   OK&#10;Total alarma    1,924 A / 7,0 A          27,5 %   OK&#10;Caida peor caso 19,72 V &gt;= 16 V minimo            OK&#10;Bateria         4,26 AH calc / 12 AH instalada    OK&#10;                (gabinete admite hasta 18 AH)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1262" y="152.0" width="390" height="250" as="geometry" /></mxCell><mxCell id="NOT" value="NOTAS DE DISENO" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="400.0" width="410" height="620" as="geometry" /></mxCell><mxCell id="NOTT" value="1. Panel en el Electrical Room del sotano, donde ya&#10;   esta la acometida. El anunciador ANN-80 va en el&#10;   East Foyer: el vestibulo historico mide 5,5 x 8 ft&#10;   y no admite un gabinete de 19 x 17 in.&#10;&#10;2. Una sola conexion vertical interior (escalera del&#10;   South Foyer). Las otras dos indicaciones &quot;DN&quot; del&#10;   plano son escaleras exteriores.&#10;&#10;3. Deteccion TERMICA en los dos cuartos mecanicos:&#10;   ambiente con combustion y polvo, no apto para humo.&#10;&#10;4. Sanitarios y baño: sin detector, pero SI con&#10;   notificacion visual (strobe).&#10;&#10;5. Cableado NAC: 16 AWG FPLR. Verificado por caida&#10;   de tension con metodo conservador (toda la&#10;   corriente por toda la longitud).&#10;&#10;6. EOL de 4,7 kohm 1/2 W (P/N 71252) en cada NAC&#10;   Clase B.&#10;&#10;7. Compatibilidad panel-notificacion respaldada por&#10;   el Fire-Lite Device Compatibility Document&#10;   P/N 15384:BR, donde el MS-9600LS aparece listado&#10;   con la familia System Sensor SpectrAlert Advance.&#10;&#10;8. Sincronizacion de destello: en la planta libre del piso 1&#10;   hay mas de dos aparatos visibles en un mismo campo de&#10;   vision, por lo que NFPA 72 cap. 18 exige que destellen&#10;   sincronizados. Los 4 NAC se programan con sincronizacion&#10;   tipo System Sensor en el propio panel (manual 52646:B,&#10;   3.6.5.5.8). No se requiere modulo externo MDL3.&#10;&#10;9. ANN-BUS: 4 conductores 18 AWG, Clase B. Consumo del&#10;   ANN-80 = 0,040 A -&gt; admite hasta 4 688 ft con 18 AWG&#10;   (manual 52646:B, tabla 1.1); el recorrido real es ~60 ft.&#10;&#10;10. El lazo SLC Style 4 NO lleva resistencia de fin de linea:&#10;   se supervisa por comunicacion (SLC Wiring Manual 51309).&#10;   La EOL de 4,7 kohm es exclusiva de los NAC." style="text;html=1;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1262" y="432.0" width="390" height="580" as="geometry" /></mxCell><mxCell id="TIT" value="DIAGRAMA DE INTERCONEXION GENERAL (RISER)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry" /></mxCell><mxCell id="SUB" value="Paxton Carnegie Library - 254 S. Market St, Paxton, Ford County, Illinois  |  HABS IL-329&#10;Sistema Fire-Lite MS-9600LS direccionable  |  Seccion 5.2  |  Diagrama sin escala" style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="900" height="40" as="geometry" /></mxCell><mxCell id="nacnote" value="4 x NAC Clase B (Style Y)  —  16 AWG FPLR  —  EOL 4,7 kΩ ½ W al final de cada circuito" style="text;html=1;fontSize=11;align=left;fontColor=#cc0000;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="400" y="903" width="560" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>